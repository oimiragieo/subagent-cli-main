{
  "name": "subagent-cli",
  "version": "1.0.0",
  "description": "Enterprise AI Agent CLI Framework with maximum tool integration across Windows, macOS, and Linux",
  "main": "index.js",
  "bin": {
    "subagent-cli": "./cli.js"
  },
  "scripts": {
    "start": "node cli.js",
    "build": "tsc",
    "dev": "ts-node cli.ts",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "node scripts/verify-installation.js",
    "setup": "npm install && npm run build && node scripts/verify-installation.js",
    "info": "node cli.js info",
    "agents": "node cli.js agents",
    "tools": "node cli.js tools",
    "postinstall": "node -e \"console.log('\\\\n✨ Dependencies installed! Next steps:\\\\n  1. Copy .env.example to .env\\\\n  2. Add your ANTHROPIC_API_KEY to .env\\\\n  3. Run: npm run build\\\\n  4. Run: npm run verify\\\\n')\""
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "devops",
    "cloud",
    "security",
    "automation",
    "enterprise",
    "cross-platform"
  ],
  "author": "Enterprise AI Team",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "commander": "^11.0.0",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.5",
    "ora": "^5.4.1",
    "cli-table3": "^0.6.3",
    "dotenv": "^16.0.3",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "jest": "^29.6.0",
    "@types/jest": "^29.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enterprise/subagent-cli-main.git"
  },
  "bugs": {
    "url": "https://github.com/enterprise/subagent-cli-main/issues"
  },
  "homepage": "https://github.com/enterprise/subagent-cli-main#readme"
}
