# Subagent CLI Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: Anthropic API Key
# ============================================
# Get your API key from: https://console.anthropic.com/
# Required for all AI agent operations
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# OPTIONAL: Logging Configuration
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log file path (relative to project root)
LOG_FILE=./logs/subagent-cli.log

# ============================================
# OPTIONAL: Model Configuration
# ============================================
# Default Claude model to use
# Options: claude-sonnet-4.5, claude-opus-4, claude-haiku-4
DEFAULT_MODEL=claude-sonnet-4.5

# Maximum tokens for responses
MAX_TOKENS=4096

# ============================================
# OPTIONAL: Cost Management
# ============================================
# Budget limit in USD (0 = unlimited)
BUDGET_LIMIT=0

# User/project identifier for cost attribution
USER_ID=default-user
PROJECT_ID=default-project

# ============================================
# OPTIONAL: Security Settings
# ============================================
# Enable sandbox mode for tool execution
SANDBOX_MODE=false

# Allow sudo commands (use with caution)
ALLOW_SUDO=false

# Require confirmation for destructive commands
CONFIRM_DESTRUCTIVE=true

# ============================================
# OPTIONAL: Performance Settings
# ============================================
# Command execution timeout in milliseconds
EXECUTION_TIMEOUT=300000

# Maximum number of retries for failed commands
MAX_RETRIES=3

# Cache TTL in seconds
CACHE_TTL=3600
